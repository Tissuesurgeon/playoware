DATABASE_URL="postgresql://playoware:playoware@localhost:5434/playoware"
# Supabase needs TLS, and the match listener needs a session connection.
# Use the direct URL or the session pooler (port 5432). Port 6543 cannot LISTEN.
# DATABASE_URL="postgresql://postgres.[project]:[password]@db.[project].supabase.co:5432/postgres?sslmode=require"
WS_PORT=3001
RECONNECT_GRACE_MS=60000
INVITE_TTL_MS=86400000
QUEUE_TTL_MS=120000
# Optional. In local development the socket is ws://<hostname>:3001.
# A production build uses the same host and port as the site. Set this only to point elsewhere.
# NEXT_PUBLIC_WS_URL="wss://playoware.example"
